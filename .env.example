# Shared secret with Railway SK11 (WHATSAPP_BRIDGE_SECRET)
BRIDGE_SECRET=change-me-to-a-long-random-string

# SK11 inbound API (Railway)
SK11_INBOUND_URL=https://sk11finance.up.railway.app/api/internal/whatsapp/inbound

# HTTP listen (Tunnel points here)
PORT=8787
HOST=127.0.0.1

# LocalAuth session directory (backup this folder)
WWEBJS_DATA_PATH=.wwebjs_auth

# Optional: only forward messages from these E.164 digits (comma-separated)
# ALLOWED_PHONES=85291234567,85291111111

# Outbound send spacing (ms) to reduce burst behaviour
SEND_GAP_MS=1500

# Request timeout to SK11 (ms)
SK11_TIMEOUT_MS=30000
